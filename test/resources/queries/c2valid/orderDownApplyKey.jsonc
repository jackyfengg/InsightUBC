
{
	"title": "ORDER DOWN by applykey",
	"input": {
		"WHERE": {},
		"OPTIONS": {
			"COLUMNS": ["small_dept", "maxAvg"],
			"ORDER": { "dir": "DOWN", "keys": ["maxAvg"] }
		},
		"TRANSFORMATIONS": {
			"GROUP": ["small_dept"],
			"APPLY": [{ "maxAvg": { "MAX": "small_avg" } }]
		}
	},
	"errorExpected": false,
	"expected": [
		{ "small_dept": "math", "maxAvg": 91.2 },
		{ "small_dept": "engl", "maxAvg": 88 },
		{ "small_dept": "cpsc", "maxAvg": 85.5 }
	]
}
