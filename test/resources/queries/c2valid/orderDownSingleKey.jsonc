
{
	"title": "ORDER object form with single key DOWN, no transformations",
	"input": {
		"WHERE": { "GT": { "small_avg": 80 } },
		"OPTIONS": {
			"COLUMNS": ["small_dept", "small_avg"],
			"ORDER": { "dir": "DOWN", "keys": ["small_avg"] }
		}
	},
	"errorExpected": false,
	"expected": [
		{ "small_dept": "math", "small_avg": 91.2 },
		{ "small_dept": "engl", "small_avg": 88 },
		{ "small_dept": "cpsc", "small_avg": 85.5 },
		{ "small_dept": "cpsc", "small_avg": 82 }
	]
}

