{
  "title": "Complex nested OR AND NOT",
  "input": {
    "WHERE": {
      "OR": [
        {
          "AND": [
            { "NOT": { "IS": { "small_dept": "cpsc" } } },
            { "GT": { "small_avg": 88 } }
          ]
        },
        {
          "EQ": { "small_year": 1900 }
        }
      ]
    },
    "OPTIONS": {
      "COLUMNS": [
        "small_dept",
        "small_avg",
        "small_year"
      ],
      "ORDER": "small_avg"
    }
  },
  "errorExpected": false,
  "expected": [
    {
      "small_dept": "cpsc",
      "small_avg": 82,
      "small_year": 1900
    },
    {
      "small_dept": "math",
      "small_avg": 91.2,
      "small_year": 2020
    }
  ]
}
