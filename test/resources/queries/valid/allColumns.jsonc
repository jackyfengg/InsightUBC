{
	"title": "all mfields and sfields in COLUMNS",
	"input": {
		"WHERE": {
			"IS": {
				"small_dept": "engl"
			}
		},
		"OPTIONS": {
			"COLUMNS": [
				"small_dept",
				"small_id",
				"small_avg",
				"small_pass",
				"small_fail",
				"small_audit",
				"small_year",
				"small_instructor",
				"small_title",
				"small_uuid"
			],
			"ORDER": "small_avg"
		}
	},
	"errorExpected": false,
	"expected": [
		{
			"small_dept": "engl",
			"small_id": "100",
			"small_avg": 88,
			"small_pass": 100,
			"small_fail": 5,
			"small_audit": 1,
			"small_year": 2019,
			"small_instructor": "Alice Brown",
			"small_title": "Intro to English",
			"small_uuid": "7"
		}
	]
}
